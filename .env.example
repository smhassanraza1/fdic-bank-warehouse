# Copy to .env and fill in real values. Never commit .env.

# --- FDIC BankFind Suite API ---
FDIC_API_BASE=https://banks.data.fdic.gov/api/
FDIC_BULK_DOWNLOAD_URL=https://banks.data.fdic.gov/bankfind-suite/bulkData/bulkDataDownload

# --- Cloudflare R2 (raw storage, S3-compatible via boto3) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fig-bronze
R2_ENDPOINT_URL=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_REGION=auto

# --- BigQuery Sandbox (curated warehouse) ---
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
BQ_PROJECT=
BQ_DATASET=fig_gold
BQ_LOCATION=US

# --- Apache Kafka (streaming path) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_FILING_RECEIVED=filing.received
KAFKA_CONSUMER_GROUP=fig-raw-writer

# --- Airflow (Docker Compose) ---
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW_FERNET_KEY=

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
